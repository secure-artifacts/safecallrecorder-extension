{
  "manifest_version": 3,
  "name": "SafeCallRecorder",
  "version": "1.4.39",
  "description": "本机保存的网页和声音输入设备录音工具，可选上传到 Google Drive。",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "downloads",
    "activeTab",
    "tabs",
    "identity"
  ],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "CONFIGURE_IN_GOOGLE_CLOUD.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/drive.readonly",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_title": "打开 SafeCallRecorder",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [],
  "minimum_chrome_version": "116"
}

{
  "manifest_version": 3,
  "name": "SafeCallRecorder",
  "version": "1.0.0",
  "description": "本机保存的网页和声音输入设备录音工具。",
  "permissions": ["tabCapture", "offscreen", "storage", "unlimitedStorage", "downloads", "activeTab"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_title": "打开 SafeCallRecorder",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [],
  "minimum_chrome_version": "116"
}
